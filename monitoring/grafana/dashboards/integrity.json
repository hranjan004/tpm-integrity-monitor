{
  "uid": "tpm-integrity",
  "title": "TPM Device Integrity",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Latest attestation verdict",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "integrity_device_trusted",
          "legendFormat": "{{device}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Attestations by result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "integrity_attestations_total",
          "legendFormat": "{{device}} {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Seconds since last report",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "time() - integrity_last_attestation_timestamp_seconds",
          "legendFormat": "{{device}} {{reason}}",
          "refId": "A"
        }
      ]
    }
  ]
}
